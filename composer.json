{
    "name": "javaabu/exports",
    "description": "Streaming model exports for Laravel: smart defaults, CSV, XLSX and ODS, background jobs and an exports UI with live progress",
    "homepage": "https://github.com/Javaabu/exports",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "exports",
        "csv",
        "xlsx",
        "openspout"
    ],
    "authors": [
        {
            "name": "Arushad Ahmed",
            "email": "arushad@javaabu.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/permissions"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "javaabu/permissions": "^3.0@dev",
        "laravel/serializable-closure": "^2.0",
        "openspout/openspout": "^5.0"
    },
    "require-dev": {
        "javaabu/boost-javaabu-guidelines": "^1.0",
        "laravel/pint": "^1.24",
        "laravel/reverb": "^1.12",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8"
    },
    "suggest": {
        "laravel/reverb": "Broadcasts export progress live; pages poll without it (^1.12)",
        "inertiajs/inertia-laravel": "Renders the exports pages with Inertia React when exports.views is inertia (^2.0)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\Exports\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\Exports\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "benchmark": "vendor/bin/phpunit --group benchmark",
        "test-coverage": "vendor/bin/phpunit --coverage-clover build/coverage.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-next-gen": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\Exports\\ExportsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
